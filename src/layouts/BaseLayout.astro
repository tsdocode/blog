---
import '../styles/global.css';
const { title = 'tsdocode', description = 'Clean. Technical. Minimal.' } = Astro.props;
const path = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = Astro.site ? new URL(path, Astro.site).toString() : `https://tsdocode.github.io${path}`;
const socialImage = Astro.site ? new URL(`${baseUrl}og-card.svg`, Astro.site).toString() : 'https://tsdocode.github.io/blog/og-card.svg';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tsdocode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title} · tsdocode</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={baseUrl}><span class="brand-mark mono">&lt;/&gt;</span> tsdocode</a>
        <nav class="nav-links" aria-label="Main navigation">
          <a class={path === '/blog' || path === '/blog/' ? 'active' : ''} href={baseUrl}>Blog</a>
        </nav>
        <div class="nav-actions"><a class="nav-mark" href="https://github.com/tsdocode" aria-label="GitHub">GH</a><a class="nav-mark nav-x" href="https://x.com/tsdocode" aria-label="X">X</a><a class="rss-mark" href={`${baseUrl}rss.xml`}>RSS <span>↗</span></a><button class="icon-button" aria-label="Toggle theme" id="theme-toggle"><span class="theme-mark"></span></button><span class="mobile-menu" aria-hidden="true">MENU</span></div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="shell footer-row"><span>© 2026 tsdocode</span><span><a href={`${baseUrl}rss.xml`}>RSS ↗</a></span></div></footer>
    <script is:inline>
      const toggle = document.querySelector('#theme-toggle');
      const savedTheme = localStorage.getItem('tsdocode-theme');
      if (savedTheme === 'dim') document.documentElement.classList.add('dim');
      toggle?.addEventListener('click', () => {
        const isDim = document.documentElement.classList.toggle('dim');
        localStorage.setItem('tsdocode-theme', isDim ? 'dim' : 'light');
        document.dispatchEvent(new CustomEvent('tsdocode:theme-change'));
      });

      document.querySelectorAll('pre.astro-code').forEach((block) => {
        const code = block.querySelector('code');
        if (!code || block.querySelector('.copy-code')) return;
        const copyButton = document.createElement('button');
        copyButton.className = 'copy-code';
        copyButton.type = 'button';
        copyButton.textContent = 'Copy';
        copyButton.setAttribute('aria-label', 'Copy code to clipboard');
        copyButton.addEventListener('click', async () => {
          await navigator.clipboard.writeText(code.textContent ?? '');
          copyButton.textContent = 'Copied';
          copyButton.classList.add('is-copied');
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
            copyButton.classList.remove('is-copied');
          }, 1600);
        });
        block.append(copyButton);
      });
    </script>
  </body>
</html>
