---
// Inferentia2 chip: 2 NeuronCore-v2, 2 HBM stacks, DMA engines, collective cores, NeuronLink, PCIe host link.
---
<svg viewBox="0 0 760 380" xmlns="http://www.w3.org/2000/svg">
  <rect class="d-bg" x="0" y="0" width="760" height="380" rx="12" />
  <!-- chip outline -->
  <rect class="d-box" x="20" y="20" width="720" height="340" rx="14" />
  <text class="d-label" x="38" y="44">INFERENTIA2 CHIP</text>
  <text class="d-mono" x="560" y="44">190 TFLOPS bf16 / chip</text>

  <!-- HBM stacks -->
  <rect class="d-amber" x="40" y="66" width="150" height="110" rx="10" />
  <text class="d-text" x="58" y="98">HBM stack 0</text>
  <text class="d-small" x="58" y="120">16 GiB</text>
  <rect class="d-amber" x="40" y="196" width="150" height="110" rx="10" />
  <text class="d-text" x="58" y="228">HBM stack 1</text>
  <text class="d-small" x="58" y="250">16 GiB</text>
  <text class="d-mono" x="44" y="330">32 GiB · 820 GB/s total</text>

  <!-- DMA fabric -->
  <rect class="d-cyan" x="212" y="66" width="70" height="240" rx="10" />
  <text class="d-text" x="229" y="176">DMA</text>
  <text class="d-small" x="236" y="196">×32</text>
  <path class="d-flow" d="M190 121 H212 M190 251 H212" />

  <!-- NeuronCores -->
  <rect class="d-accent" x="304" y="66" width="190" height="110" rx="10" />
  <text class="d-text" x="322" y="96">NeuronCore-v2 · 0</text>
  <text class="d-small" x="322" y="118">4 engines (Tensor, Vector, …)</text>
  <text class="d-small" x="322" y="136">24 MiB SBUF · 2 MiB PSUM</text>
  <text class="d-mono" x="322" y="160">~92 TFLOPS bf16</text>
  <rect class="d-accent" x="304" y="196" width="190" height="110" rx="10" />
  <text class="d-text" x="322" y="226">NeuronCore-v2 · 1</text>
  <text class="d-small" x="322" y="248">4 engines (Tensor, Vector, …)</text>
  <text class="d-small" x="322" y="266">24 MiB SBUF · 2 MiB PSUM</text>
  <text class="d-mono" x="322" y="290">~92 TFLOPS bf16</text>
  <path class="d-flow" d="M282 121 H304 M282 251 H304" />

  <!-- collectives + links -->
  <rect class="d-green" x="516" y="66" width="204" height="70" rx="10" />
  <text class="d-text" x="532" y="94">Collective cores ×6</text>
  <text class="d-small" x="532" y="114">AllReduce / AllGather offload</text>
  <rect class="d-pink" x="516" y="151" width="204" height="70" rx="10" />
  <text class="d-text" x="532" y="179">NeuronLink-v2 ×2</text>
  <text class="d-small" x="532" y="199">chip ↔ chip (inf2.24xl / 48xl)</text>
  <rect class="d-box" x="516" y="236" width="204" height="70" rx="10" />
  <text class="d-text" x="532" y="264">PCIe to host CPU</text>
  <text class="d-small" x="532" y="284">inf2.xlarge: 4 vCPU, 16 GiB</text>
  <path class="d-line" d="M494 121 H516 M494 186 H516 M494 251 H516" />
</svg>
