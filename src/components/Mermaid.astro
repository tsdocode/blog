---
interface Props {
  chart: string;
  title?: string;
}

const { chart, title = 'Mermaid diagram' } = Astro.props;
---

<figure class="mermaid-frame">
  <div class="mermaid" data-chart={chart} role="img" aria-label={title}>{chart}</div>
</figure>

<script>
  import mermaid from 'mermaid';

  // Astro bundles this component script once per page, so discover all
  // diagrams here and render them sequentially. Sequential rendering keeps
  // Mermaid's shared parser state from being used concurrently.
  const renderDiagrams = async () => {
    const diagrams = [...document.querySelectorAll<HTMLElement>('.mermaid[data-chart]')];
    if (!diagrams.length) return;

    const isDim = document.documentElement.classList.contains('dim');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      themeVariables: isDim ? {
        background: '#101a20',
        primaryColor: '#1d1b3c',
        primaryTextColor: '#f2f4f5',
        primaryBorderColor: '#8b82ff',
        lineColor: '#8b82ff',
        secondaryColor: '#15352d',
        tertiaryColor: '#152128',
        fontFamily: 'ui-sans-serif, system-ui, sans-serif'
      } : {
        background: '#ffffff',
        primaryColor: '#eeedff',
        primaryTextColor: '#111318',
        primaryBorderColor: '#5146f5',
        lineColor: '#5146f5',
        secondaryColor: '#effaf5',
        tertiaryColor: '#f3f4f6',
        fontFamily: 'ui-sans-serif, system-ui, sans-serif'
      },
      flowchart: { useMaxWidth: true, htmlLabels: false }
    });

    for (const [index, diagram] of diagrams.entries()) {
      const chart = diagram.getAttribute('data-chart') ?? '';
      diagram.innerHTML = '';

      try {
        const id = `mermaid-diagram-${index}`;
        const { svg, bindFunctions } = await mermaid.render(id, chart);
        diagram.innerHTML = svg;
        bindFunctions?.(diagram);
      } catch (error) {
        console.error('Unable to render Mermaid diagram:', chart, error);
      }
    }
  };

  renderDiagrams();
  document.addEventListener('tsdocode:theme-change', renderDiagrams);
</script>
