---
import { render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getGuideTree } from '../../lib/guide';

export async function getStaticPaths() {
  const { flat } = await getGuideTree();
  return flat.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<GuideLayout title={entry.data.title} description={entry.data.summary} currentId={entry.id} short={entry.data.short} related={entry.data.related}>
  <Content />
</GuideLayout>
