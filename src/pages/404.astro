---
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="404" description="This note does not exist yet.">
  <div class="shell not-found"><div class="not-found-code mono">404</div><div><span class="post-kicker">A quiet dead end</span><h1>This note does not exist yet.</h1><p>The page you’re looking for may have moved, or it has not been written.</p><a class="button" href={baseUrl}>Back to the notebook →</a></div></div>
</BaseLayout>
