---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<BaseLayout title="Blog" description="Systems, AI, and open-source notes by tsdocode.">
  <div class="shell landing default-landing">
    <section class="landing-intro">
      <div>
        <div class="breadcrumbs">tsdocode / blog</div>
        <h1>Notes on systems<br /><em>that do the work.</em></h1>
      </div>
      <p>Technical writing on systems, AI infrastructure, and the quiet details that make software reliable.</p>
    </section>
    {posts.length ? <section class="published-welcome">
      <div class="welcome-number mono">{String(posts.length).padStart(2, '0')} / published {posts.length === 1 ? 'note' : 'notes'}</div>
      <div><span class="post-kicker">Latest note</span><h2><a href={`${baseUrl}posts/${posts[0].id}/`}>{posts[0].data.title}</a></h2><p class="manifesto">{posts[0].data.description}</p><div class="post-meta">{formatDate(posts[0].data.date)} <span>·</span> {posts[0].data.readTime}</div></div>
    </section> : <section class="default-welcome">
      <div class="welcome-number mono">00 / published notes</div>
      <div>
        <span class="post-kicker">The notebook is open</span><span class="welcome-status">First note in progress.</span>
        <h2>No posts published yet.</h2>
        <p class="manifesto">Notes from building things close to the metal.<br />Benchmarks, failures, internals, and lessons worth keeping.</p>
      </div>
    </section>}
    {posts.length > 1 && <section class="latest-section"><div class="section-heading"><h2>More notes</h2><span class="mono">{posts.length.toString().padStart(2, '0')} posts</span></div><div class="notes-list">{posts.slice(1).map((post, index) => <a class="note-row" href={`${baseUrl}posts/${post.id}/`}><span class="note-number mono">{String(index + 2).padStart(2, '0')}</span><span class="note-main"><span class="post-kicker">{post.data.category} · {post.data.tags.slice(0, 2).join(' / ')}</span><strong>{post.data.title}</strong><p>{post.data.description}</p></span><span class="note-date">{formatDate(post.data.date)}<br /><small>{post.data.readTime}</small></span><span class="row-arrow">↗</span></a>)}</div></section>}
    <section class="topic-strip"><span class="post-kicker">Planned territory</span><div class="rail-list"><span>AI Runtime</span><span>GPU Systems</span><span>Linux</span><span>Inference</span><span>Open Source</span></div></section>
  </div>
</BaseLayout>
