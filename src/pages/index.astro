---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Blog" description="Systems, AI, and open-source notes by tsdocode.">
  <div class="shell landing default-landing">
    <section class="landing-intro">
      <div>
        <div class="breadcrumbs">tsdocode / blog</div>
        <h1>Notes on systems<br /><em>that do the work.</em></h1>
      </div>
      <p>Technical writing on systems, AI infrastructure, and the quiet details that make software reliable.</p>
    </section>
    <section class="default-welcome">
      <div class="welcome-number mono">00</div>
      <div>
        <span class="post-kicker">The notebook is open</span>
        <h2>No posts published yet.</h2>
        <p>Add your first Markdown or MDX file to <code>src/content/posts/</code> and it will appear here automatically.</p>
        <div class="welcome-actions"><a class="button button-primary" href={`${baseUrl}projects/`}>View projects ↗</a><span class="mono welcome-path">/src/content/posts/</span></div>
      </div>
    </section>
    <section class="topic-strip"><span class="post-kicker">Planned topics</span><div class="rail-list"><span>Systems</span><span>AI infrastructure</span><span>Linux</span><span>Open source</span></div></section>
  </div>
</BaseLayout>
