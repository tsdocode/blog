---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  { name: 'RoomMesh', type: 'Open source · realtime', description: 'A small multiplayer layer for browser party games, built around room state and phone controllers.', tone: 'project-indigo', url: 'https://github.com/tsdocode' },
  { name: 'Edo Tensei', type: 'Systems · CUDA', description: 'Experiments in checkpointing initialized GPU workloads for fast, repeatable restarts.', tone: 'project-green', url: 'https://github.com/tsdocode' },
  { name: 'Signal Garden', type: 'Tools · voice AI', description: 'A focused sandbox for composing low-latency speech pipelines from small, observable parts.', tone: 'project-blue', url: 'https://github.com/tsdocode' }
];
---
<BaseLayout title="Projects" description="Selected systems and AI projects by tsdocode.">
  <div class="shell projects-page">
    <div class="breadcrumbs">tsdocode / projects</div>
    <div class="projects-header"><h1>Things I’m<br /><em>building.</em></h1><p>Small tools, experiments, and open-source work at the intersection of systems and AI.</p></div>
    <div class="project-list">{projects.map((project, index) => <a class="project-item" href={project.url}><div class={`project-art ${project.tone}`}><span class="mono">0{index + 1}</span><i></i></div><div class="project-copy"><span class="post-kicker">{project.type}</span><h2>{project.name}</h2><p>{project.description}</p><span class="project-link">View project ↗</span></div></a>)}</div>
  </div>
</BaseLayout>
